# NovaFrame API safety switch: live generation is disabled unless explicitly enabled.
MUSEFORGE_ENABLE_LIVE_GENERATION=false
# Keep the UI loopback-only unless you intentionally trust every LAN client.
MUSEFORGE_ALLOW_LAN=false
# Hard cap for one submitted batch after task/shot expansion.
MUSEFORGE_MAX_GENERATION_ITEMS=120
# Bound queued + running paid batches so the in-process executor queue is finite.
MUSEFORGE_MAX_ACTIVE_GENERATION_RUNS=4
# Optional override. Defaults to ./workspace.
# MUSEFORGE_WORKSPACE_ROOT=/absolute/path/to/your/workspace

# Legacy Image2 fallback. Prefer registering managed channels in the Settings UI.
# These values are used only when no managed channel exists.
IMAGE_API_BASE_URL=
IMAGE_API_ENDPOINT=/images/edits
IMAGE_API_KEY=
IMAGE_MODEL=gpt-image-2
IMAGE_SIZE=1024x1024
IMAGE_QUALITY=medium
IMAGE_OUTPUT_FORMAT=png
IMAGE_COMBO_CONCURRENCY=4

# Existing CanvasPilot / ComfyUI service.
COMFYUI_BASE_URL=http://127.0.0.1:38188
